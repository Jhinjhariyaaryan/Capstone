{
  "version": 2,
  "builds": [
    {
      "src": "Online-Examination-Portal/Backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Online-Examination-Portal/Frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Online-Examination-Portal/Backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "Online-Examination-Portal/Frontend/$1"
    }
  ]
}